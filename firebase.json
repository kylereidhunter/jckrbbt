{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/createLinkToken",
        "function": "createLinkToken"
      },
      {
        "source": "/api/exchangePlaidToken", 
        "function": "exchangePlaidToken"
      },
      {
        "source": "/api/getHoldings",
        "function": "getHoldings"
      },
      {
        "source": "/api/disconnectPlaid",
        "function": "disconnectPlaid"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
